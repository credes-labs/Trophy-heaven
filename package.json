{
  "name": "trophy-heaven",
  "version": "0.1.0",
  "private": true,
  "description": "Trophy Heaven — premium e-commerce for custom trophies and awards with a 2D/3D customization engine.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm schemas:build && pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm schemas:build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "schemas:build": "pnpm --filter @trophy-heaven/schemas build",
    "schemas:test": "pnpm --filter @trophy-heaven/schemas test"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.16.0"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@swc/core": "1.5.7",
        "picomatch": "4"
      }
    }
  }
}
