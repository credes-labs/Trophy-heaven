{
  "name": "@legacy-crafts/schemas",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas + TypeScript types: custom entities and 2D/3D design-state contracts (see docs/kit/06-data-models.md).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@legacy-crafts/config": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
