{
  "name": "@trophy-heaven/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Trophy Heaven storefront — Next.js 16 App Router with RSC catalog, cart/checkout, and the 2D/3D customization engine.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter @trophy-heaven/schemas build && next build",
    "start": "next start -p 3000",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "images:webp": "node scripts/images-to-webp.mjs"
  },
  "dependencies": {
    "@trophy-heaven/schemas": "workspace:*",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/types": "2.18.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "@tanstack/react-query": "^5.101.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fabric": "^7.4.0",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.10",
    "motion": "^13.0.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.6.0",
    "three": "^0.180.0",
    "three-globe": "^2.45.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "sharp": "0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
