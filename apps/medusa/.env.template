# Medusa backend env (see docs/kit/14-appendices.md §D for the full reference).
NODE_ENV=development
DATABASE_URL=postgres://medusa:medusa@localhost:5432/trophy_heaven
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_CORS=http://localhost:9000,http://127.0.0.1:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:9000,http://127.0.0.1:9000
JWT_SECRET=change_me
COOKIE_SECRET=change_me

# Storage (Cloudflare R2 / S3) — leave blank for local on-disk uploads in dev
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications
RESEND_API_KEY=
RESEND_FROM=Trophy Heaven <no-reply@trophyheaven.example>
# Shop owner inbox: gets every new order with links to the customer's uploaded files.
ORDER_NOTIFY_EMAIL=
MSG91_AUTH_KEY=
# OTP sign-in (email via Resend, SMS via MSG91). OTP_DEV_ECHO=true returns the code in
# the API response and logs it — local development only; ignored when NODE_ENV=production.
OTP_DEV_ECHO=false

# Search (Phase 6)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey_dev_only_change_me

# Local admin (created/reset by scripts/dev-up + seed path):
#   admin@trophyheaven.test / TrophyHeaven!Dev1
