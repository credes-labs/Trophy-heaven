# Legacy Crafts — environment variable reference (see docs/kit/14-appendices.md §D).
# Names are indicative. Keep real values in a managed secret store, never in the repo.
# Copy to .env for local dev; apps read their own subset (see apps/*/.env.template).

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgres://medusa:medusa@localhost:5432/legacy_crafts   # PostgreSQL 18
REDIS_URL=redis://localhost:6379                                     # Redis 7 / Valkey 8
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=supersecret_dev_jwt
COOKIE_SECRET=supersecret_dev_cookie

# ── Search ──────────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey_dev_only_change_me
# or ALGOLIA_APP_ID= / ALGOLIA_API_KEY=

# ── Storage / CDN / media ─────────────────────────────────────────────────────
# Default: Cloudflare R2 (S3-compatible). S3_* equivalents also supported.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                       # e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=
CLOUDINARY_URL=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Shipping ──────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_TOKEN=
# or DELHIVERY_API_TOKEN=

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Legacy Crafts <orders@legacycrafts.example>
# or SENDGRID_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
# or TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN=

# ── Observability / analytics ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_GA4_ID=
MIXPANEL_TOKEN=
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Comma-separated feature flags, e.g. "visual_search,new_checkout"; prefix with ! to force-off
NEXT_PUBLIC_FLAGS=

# ── Frontend (storefront) ─────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_CDN_BASE_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
